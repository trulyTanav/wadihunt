{
  "appId": "fun.wadihunt.app",
  "appName": "WadiHunt",
  "webDir": "dist",
  "backgroundColor": "#0B0914",
  "server": {
    "cleartext": true,
    "androidScheme": "https"
  },
  "android": {
    "buildOptions": {
      "keystorePath": "",
      "releaseType": "APK"
    }
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "backgroundColor": "#0B0914",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0B0914"
    }
  }
}
